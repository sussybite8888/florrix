# Writes the staged content directory into a C++ source file, for the native
# offline build to carry inside its executable (shared/core/embedded_files.h).
#
#   cmake -DFLIX_DATA_DIR=<staged dir> -DFLIX_DATA_MANIFEST=<names, one a line>
#         -DFLIX_EMBEDDED_OUTPUT=<out.cpp> -P embed_content.cmake
#
# The manifest is the one the staging writes (staged_content.txt): every file
# the directory is meant to hold, the font included, and nothing it is not --
# so what is embedded is exactly what this tree declares as content.

file(STRINGS "${FLIX_DATA_MANIFEST}" names)
list(SORT names)

set(arrays "")
set(table "")
set(index 0)
foreach(name IN LISTS names)
  if(name STREQUAL "")
    continue()
  endif()
  set(path "${FLIX_DATA_DIR}/${name}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "embed_content: ${path} is in the manifest but was not staged")
  endif()
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  if(size EQUAL 0)
    # An array cannot be empty; its size says it holds nothing.
    set(bytes "0x00")
  else()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  endif()
  string(APPEND arrays "const unsigned char k${index}[] = {${bytes}};\n")
  string(REPLACE "\\" "\\\\" quoted "${name}")
  string(REPLACE "\"" "\\\"" quoted "${quoted}")
  string(APPEND table "    {\"${quoted}\", k${index}, ${size}},\n")
  math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${FLIX_EMBEDDED_OUTPUT}"
"// Generated by cmake/embed_content.cmake from the staged content. Do not edit.

#include <cstddef>

#include \"shared/core/embedded_files.h\"

namespace {
${arrays}} // namespace

namespace flix {

extern const EmbeddedFile kEmbeddedContent[] = {
${table}};
extern const std::size_t kEmbeddedContentCount = ${index};

} // namespace flix
")
